# Copia este archivo a .env (o define las variables en tu proveedor de hosting).

# Puerto HTTP
PORT=8080

# URL pública del servidor (https). Se usa para el webhook de Fintoc.
PUBLIC_URL=https://tu-servidor.example.com

# Llaves de Fintoc (https://dashboard.fintoc.com). La secreta NUNCA va en la app.
FINTOC_PUBLIC_KEY=pk_live_xxxxxxxx
FINTOC_SECRET_KEY=sk_live_xxxxxxxx

# 32 bytes aleatorios en base64 para cifrar los link_token guardados.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Clave compartida que la app usa una sola vez para registrar tu iPhone.
# Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_SECRET=

# Carpeta donde se guarda la base de datos (JSON cifrado parcialmente).
DATA_DIR=./data
